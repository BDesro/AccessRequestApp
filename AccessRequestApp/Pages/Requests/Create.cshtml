@page
@model AccessRequestApp.Pages.Requests.CreateModel
@{
    ViewData["Title"] = "New Access Request";
}

<h1>New Access Request</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.SystemName" class="form-label"></label>
                <input asp-for="Input.SystemName" class="form-control" />
                <span asp-validation-for="Input.SystemName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.BusinessJustification" class="form-label"></label>
                <textarea asp-for="Input.BusinessJustification" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.BusinessJustification" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Submit Request</button>
            <a asp-page="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
